// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(uuid())
  name        String
  stripe_id   String?  @unique
  created_at  DateTime @default(now())

  // Vendor billing — Pulse's own subscription for this company
  plan_tier                  String   @default("free")  // 'free' | 'starter' | 'pro' | 'enterprise'
  vendor_stripe_customer_id  String?  @unique           // Pulse's Stripe customer for this company
  vendor_subscription_id     String?  @unique           // active Stripe subscription ID
  plan_expires_at            DateTime?                  // null = active / no expiry

  // Notifications & Slack Integrations
  slack_webhook_url          String?
  alert_email                String?

  customers     Customer[]
  events        Event[]
  mrr_snapshots MRRSnapshot[]
  churn_events  ChurnEvent[]
  health_scores HealthScore[]
  admins        AdminUser[]
  audit_logs    AuditLog[]
  api_keys      ApiKey[]
  notifications Notification[]
  mrr_goal      MrrGoal?
  customer_notes CustomerNote[]
  saved_segments SavedSegment[]

  // Custom health score signal weights (JSON: { paymentWeightPct, accountAgeWeightPct, ... })
  // Persisted here so rules survive server restarts and multi-instance deployments.
  health_score_config String @default("{}")
}


model AdminUser {
  id              String   @id @default(uuid())
  company_id      String
  company         Company  @relation(fields: [company_id], references: [id])
  email           String
  password_hash   String
  role            String   @default("ADMIN") // 'OWNER' | 'ADMIN' | 'ANALYST' | 'DEVELOPER'
  mfa_secret      String?  // TOTP secret (null until enrolled)
  mfa_enabled     Boolean  @default(false)
  created_at      DateTime @default(now())

  reset_tokens    PasswordResetToken[]

  @@unique([company_id, email])
  @@index([email])
}

// ─── Scoped API Keys ──────────────────────────────────────────────────────────

model ApiKey {
  id           String    @id @default(uuid())
  company_id   String
  company      Company   @relation(fields: [company_id], references: [id])
  name         String
  key_prefix   String    // e.g. "pulse_live_a1b2..."
  hashed_key   String    @unique
  scopes       String    @default("read:analytics") // comma-separated: 'read:analytics,write:customers,read:accounts'
  last_used_at DateTime?
  revoked_at   DateTime?
  created_at   DateTime  @default(now())

  @@index([company_id])
  @@index([hashed_key])
}

// ─── Password Reset ───────────────────────────────────────────────────────────

model PasswordResetToken {
  id         String    @id @default(uuid())
  token      String    @unique
  admin_id   String
  admin      AdminUser @relation(fields: [admin_id], references: [id])
  expires_at DateTime
  used       Boolean   @default(false)
  created_at DateTime  @default(now())

  @@index([token])
  @@index([admin_id])
}

model Customer {
  id               String   @id @default(uuid())
  company_id       String
  company          Company  @relation(fields: [company_id], references: [id])
  external_id      String?  // e.g., Stripe customer_id — unique per company, not globally
  email            String
  name             String
  plan             String
  status           String   // 'active' | 'past_due' | 'canceled' | 'trialing'
  mrr_cents        Int      @default(0)
  billing_cycle    String   // 'monthly' | 'yearly'
  trial_ends_at    DateTime?
  created_at       DateTime @default(now())

  subscriptions  Subscription[]
  events         Event[]
  health_scores  HealthScore[]
  churn_events   ChurnEvent[]
  notes          CustomerNote[]

  @@unique([company_id, external_id])
  @@index([company_id])
  @@index([status])
  // Compound indexes for the most frequent analytics query patterns:
  @@index([company_id, status])      // customer list filter by status (every page load)
  @@index([company_id, mrr_cents])   // dunning: ORDER BY mrr_cents DESC
  @@index([company_id, created_at])  // cohort/retention: WHERE company_id ORDER BY created_at
}

model Subscription {
  id                   String   @id @default(uuid())
  customer_id          String
  customer             Customer @relation(fields: [customer_id], references: [id])
  stripe_subscription_id String? @unique
  plan                 String
  mrr_cents            Int
  status               String
  current_period_start DateTime
  current_period_end   DateTime
  canceled_at          DateTime?
  created_at           DateTime @default(now())

  @@index([customer_id])
  @@index([status])
}

model Event {
  id         String   @id @default(uuid())
  company_id String
  company    Company  @relation(fields: [company_id], references: [id])
  customer_id String?
  customer   Customer? @relation(fields: [customer_id], references: [id])
  name       String
  properties String   @default("{}")
  occurred_at DateTime @default(now())

  @@index([company_id, occurred_at(sort: Desc)])
  @@index([customer_id])
  // Funnel queries group by (company_id, name) — this index covers them
  @@index([company_id, name])
}

model MRRSnapshot {
  id                String   @id @default(uuid())
  company_id        String
  company           Company  @relation(fields: [company_id], references: [id])
  date              DateTime
  mrr_cents         Int
  new_mrr_cents     Int      @default(0)
  expansion_mrr_cents Int    @default(0)
  contraction_mrr_cents Int   @default(0)
  churned_mrr_cents Int      @default(0)
  customer_count    Int      @default(0)

  @@unique([company_id, date])
  @@index([company_id, date])
}

model HealthScore {
  id         String   @id @default(uuid())
  company_id String
  company    Company  @relation(fields: [company_id], references: [id])
  customer_id String
  customer   Customer @relation(fields: [customer_id], references: [id])
  score      Int
  signals    String   @default("{}")
  computed_at DateTime @default(now())

  @@unique([company_id, customer_id, computed_at])
  @@index([company_id])
  @@index([score])
}

model ChurnEvent {
  id           String   @id @default(uuid())
  company_id   String
  company      Company  @relation(fields: [company_id], references: [id])
  customer_id  String
  customer     Customer @relation(fields: [customer_id], references: [id])
  mrr_lost_cents Int
  reason       String
  churned_at   DateTime @default(now())

  @@index([company_id])
  @@index([reason])
}

model AuditLog {
  id         String   @id @default(uuid())
  company_id String
  company    Company  @relation(fields: [company_id], references: [id])
  user_email String
  action     String
  ip_address String?
  user_agent String?
  details    String   @default("{}")
  created_at DateTime @default(now())

  @@index([company_id, created_at(sort: Desc)])
  @@index([action])
}

// ─── In-App Notification Feed ─────────────────────────────────────────────────

model Notification {
  id         String   @id @default(uuid())
  company_id String
  company    Company  @relation(fields: [company_id], references: [id])
  type       String   // 'churn' | 'payment_failed' | 'health_drop' | 'new_customer' | 'goal_reached'
  title      String
  body       String
  read       Boolean  @default(false)
  meta       String   @default("{}") // JSON: { customerId, mrrCents, ... }
  created_at DateTime @default(now())

  @@index([company_id, created_at(sort: Desc)])
  @@index([company_id, read])
}

// ─── MRR Goal & Revenue Target ────────────────────────────────────────────────

model MrrGoal {
  id               String   @id @default(uuid())
  company_id       String   @unique
  company          Company  @relation(fields: [company_id], references: [id])
  label            String   @default("MRR Target")
  target_mrr_cents Int
  target_date      DateTime
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}

// ─── Customer CRM Notes ───────────────────────────────────────────────────────

model CustomerNote {
  id          String   @id @default(uuid())
  company_id  String
  company     Company  @relation(fields: [company_id], references: [id])
  customer_id String
  customer    Customer @relation(fields: [customer_id], references: [id])
  author      String   // admin email
  body        String
  created_at  DateTime @default(now())

  @@index([customer_id])
  @@index([company_id])
}

// ─── Saved Customer Segments ──────────────────────────────────────────────────

model SavedSegment {
  id         String   @id @default(uuid())
  company_id String
  company    Company  @relation(fields: [company_id], references: [id])
  name       String
  filters    String   // JSON string of filter parameters: { status, plan, minMrr, maxMrr, ... }
  created_at DateTime @default(now())

  @@index([company_id])
}

// ─── Stripe Webhook Idempotency ───────────────────────────────────────────────
// Stores processed Stripe event IDs to prevent duplicate handling on retries.
// Stripe guarantees at-least-once delivery — this guard prevents double-downgrade
// when subscription.deleted fires twice in rapid succession.

model ProcessedWebhookEvent {
  id         String   @id @default(uuid())
  event_id   String   @unique  // Stripe event ID (evt_xxx)
  event_type String
  processed_at DateTime @default(now())

  @@index([event_id])
  @@index([processed_at])
}

// ─── Scheduled Job Locks ────────────────────────────────────────────────────
// Prevents duplicate execution of background workers when the API runs with
// multiple replicas or restarts overlap with in-flight jobs.

model JobLock {
  name       String   @id
  owner_id   String
  locked_until DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([locked_until])
}